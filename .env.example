# Sidecar listener. Production cloudflared points to this loopback port.
AE2_LISTEN_ADDR=127.0.0.1:8080
AE2_DIST_DIR=/opt/ae2-gateway/dashboard
# Comma-separated; the first origin is canonical.
AE2_PUBLIC_ORIGIN=https://ae2.example.com

# Private Minecraft mod API.
AE2_MOD_URL=http://127.0.0.1:8765
AE2_MOD_SECRET=replace-with-a-random-service-secret

# Cloudflare Access. Required unless AE2_DEV_IDENTITY is enabled on loopback.
AE2_CF_ISSUER=https://your-team.cloudflareaccess.com
AE2_CF_AUDIENCE=replace-with-access-application-aud

# Tailscale-trusted mode. Exposes the dashboard on a tailnet address without
# Cloudflare. Bind only a 100.64.0.0/10 address and keep the port off the public
# internet. Every request is treated as AE2_TAILSCALE_IDENTITY.
AE2_TRUST_TAILSCALE=
AE2_TAILSCALE_IDENTITY=

# Local development only. Production refuses this option on non-loopback binds.
AE2_DEV_IDENTITY=
