# This file is documentation only; the sidecar reads its process environment.
# Always use a literal loopback IP; cloudflared connects on the same host.
AE2_LISTEN_ADDR=127.0.0.1:8080
AE2_DIST_DIR=/opt/ae2-gateway/dashboard
AE2_PUBLIC_ORIGIN=https://ae2.example.com
AE2_MOD_URL=http://127.0.0.1:8765
# Generate independently, for example: openssl rand -base64 48
AE2_MOD_SECRET=replace-with-at-least-32-random-bytes

# Production Cloudflare Access settings. The issuer is the team URL from the
# Access JWT, not the application URL.
AE2_CF_ISSUER=https://your-team.cloudflareaccess.com
AE2_CF_AUDIENCE=replace-with-access-application-aud

# Optional bounds (defaults shown).
AE2_MAX_BODY_BYTES=65536
AE2_PROXY_TIMEOUT=15s
AE2_RATE_PER_MINUTE=120
AE2_RATE_BURST=30
AE2_MUTATION_RATE_PER_MINUTE=12
AE2_MUTATION_RATE_BURST=4

# Local development only. Setting this disables Cloudflare JWT auth and makes
# startup fail unless AE2_LISTEN_ADDR and AE2_PUBLIC_ORIGIN contain literal
# loopback IPs (for example, http://127.0.0.1:8080).
# AE2_DEV_IDENTITY=developer@example.test
