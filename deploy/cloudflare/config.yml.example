# Replace values only after the Cloudflare publication approval gate.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

originRequest:
  connectTimeout: 10s
  httpHostHeader: ae2.example.com

ingress:
  - hostname: ae2.example.com
    service: http://127.0.0.1:8080
  - service: http_status:404
